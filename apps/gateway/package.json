{
  "name": "@nonna/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsdown",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "mkdir -p data && drizzle-kit migrate",
    "seed": "tsx --env-file-if-exists=../../.env scripts/seed-demo.ts",
    "family:add": "tsx --env-file-if-exists=../../.env scripts/add-family-member.ts",
    "dial:connect": "tsx --env-file-if-exists=../../.env scripts/connect-dial.ts",
    "omb:setup": "tsx --env-file-if-exists=../../.env scripts/setup-omb.ts",
    "elder:set": "tsx --env-file-if-exists=../../.env scripts/set-elder.ts"
  },
  "dependencies": {
    "@hono/mcp": "^0.3.2",
    "@hono/node-server": "^2.1.5",
    "@libsql/client": "^0.18.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@nonna/shared": "workspace:*",
    "@nonna/tools-mcp": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "tsdown": "^0.23.1",
    "vitest": "^5.0.4"
  }
}
