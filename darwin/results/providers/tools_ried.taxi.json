  {
    "name": "ried_taxi_cancel_booking",
    "title": "Cancel my RIED.TAXI booking",
    "description": "Cancels a booking, free of charge, any time before the pickup. Requires reference, access code, customer_confirmed=true after the customer explicitly confirmed, and an idempotency_key. Cannot be undone.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "booking_reference": {
          "type": "string",
          "pattern": "^RT-[A-Z0-9]{4,10}$",
          "description": "Public booking reference, e.g. RT-K7QM."
        },
        "access_code": {
          "type": "string",
          "minLength": 8,
          "maxLength": 8,
          "description": "8-character access code given at booking time."
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 8,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "description": "Unique key for this one intended action. Reuse it only when retrying the same action."
        },
        "customer_confirmed": {
          "type": "boolean",
          "const": true
