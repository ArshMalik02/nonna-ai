# Darwin API key (server-side only; never commit .env). Search works without one (anonymous, lower limit).
DARWIN_API_KEY=your-darwin-key-here

# Act is off until your key can use it (needs a Search + Act key).
DARWIN_ACT_ENABLED=false
# DARWIN_ACT_API_KEY=your-search-plus-act-key

# Optional: require this value in the X-Api-Token header on every API call.
# NONNA_API_TOKEN=choose-a-long-random-string

# REAL ride bookings. Leave false unless a human admin has approved a real booking.
RIDE_LIVE_BOOKING=false
