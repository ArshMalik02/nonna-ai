# Copy to .env and fill in. Never commit .env.

# Gateway
PORT=8787
PUBLIC_BASE_URL=https://your-tunnel.example.com
# Relative to apps/gateway (where the gateway runs).
DATABASE_URL=file:./data/nonna.db
LOG_LEVEL=info

# Dial (https://docs.getdial.ai)
DIAL_API_URL=https://api.getdial.ai
DIAL_API_KEY=sk_live_...
DIAL_WEBHOOK_SECRET=whsec_...
# Two numbers with fixed roles (see dial/README.md):
# Elder line, SMS + voice: the only number the elder texts and calls.
DIAL_ELDER_NUMBER=+14155550100
# Family line, iMessage + voice: in the family iMessage group; places outbound task calls.
DIAL_FAMILY_NUMBER=+14155550101

# Darwin (https://darwin.so/docs). auto = live Darwin when it returns a runnable agent, else the
# local catalog of 60 fictional agents (simulated Act). Also: live, proxy.
DARWIN_MODE=auto
DARWIN_API_URL=https://api.darwin.so
DARWIN_SEARCH_KEY=
# Account-owner key with agent:write (a Search key alone can't act).
DARWIN_ACT_KEY=
DARWIN_ACT_ENABLED=false

# OpenMausBot harness (run unmodified on port 8899, see omb/README.md)
OMB_API_URL=http://127.0.0.1:8899
# Nonna's model, and the engines to use: the Claude Code login first, then an Anthropic API key
# (added in OpenMausBot Settings → API keys) while the login is out of usage.
NONNA_MODEL=claude-sonnet-5-5
OMB_PRIMARY_INSTANCE=claude
OMB_FALLBACK_INSTANCE=claudeApi
OMB_API_TOKEN=
